.claude/metrics/
.ruff_cache/

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/
*.local

# Test output
coverage/
test-results/
playwright-report/

# Environment variables
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Editor directories
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# dev-team plugin reports (/review-agent, /code-review, /triage) are
# regenerated on every run, so they stay local. The exception is
# /test-improve's report data, which is meant to be committed. Keep that
# exception at the directory level (test-improve/): git never re-includes a
# path whose parent directory is excluded, so a narrower pattern such as
# */data/ would silently match nothing.
/.dev-team-reports/*
!/.dev-team-reports/test-improve/

# MCP server config holds absolute paths for this machine; committing it
# would break the setup for anyone else.
.mcp.json
.claude/memory/
